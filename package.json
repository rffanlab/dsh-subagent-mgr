{
  "name": "dsh-subagent-mgr",
  "version": "0.5.0",
  "description": "Zero-YAML subagent control plane, Web UI, and runtime telemetry for DeepSeek Harness",
  "type": "module",
  "main": "./src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./client": "./lib/client.js",
    "./core": "./src/core.js",
    "./backend-hints": "./src/backend-hints.js",
    "./telemetry": "./src/telemetry.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/core.js && node --check src/index.js && node --check src/plugin.js && node --check src/backend-hints.js && node --check src/settings-schema.js && node --check src/telemetry.js && node --check lib/client.js",
    "packcheck": "npm pack --dry-run --json",
    "upstreamcheck": "node scripts/check-upstream-contract-v5.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tool-subagent": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rffanlab/dsh-subagent-mgr.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "subagent",
    "agent",
    "plugin",
    "control-plane",
    "telemetry",
    "observability"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
